# ==========================================
# Chinese Culture Studio — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.
# Production: set these in Render dashboard → Environment.

# --- Database ---
# Local dev: SQLite (file:./dev.db)
# Production: Neon PostgreSQL (set in Render dashboard)
DATABASE_URL="file:./dev.db"

# --- PayPal Payment (Business Account, Standard Checkout) ---
# Get Live credentials from https://www.paypal.com/businessmanage/account/websettings
#   → Website Payments → Payment Data Transfer (PDT) → ON → copy Identity Token
PAYPAL_SANDBOX=false
PAYPAL_EMAIL="22728717@qq.com"
PAYPAL_PDT_TOKEN=""         # PDT Identity Token (required for instant result delivery)

# --- App URL ---
# Local dev: http://localhost:3000
# Production: https://www.culture-of-china.com (set in Render dashboard)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin ---
# Token for accessing /admin dashboard and /api/report
ADMIN_TOKEN="change-me-to-a-random-string"

# --- OpenRouter AI ---
# Used by: palm-reading, dream-interpretation
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# --- Telegram Bot (optional) ---
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
# TELEGRAM_CHAT_ID is the target channel/group ID (e.g. @yourchannel or -100xxx)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_POST_SECRET=""

# --- Resend Email (optional) ---
# Get key from https://resend.com/api-keys (free tier: 100 emails/day)
# CONTACT_EMAIL is where contact form messages and daily digests are sent
RESEND_API_KEY=""
CONTACT_EMAIL=""

# --- Cron Job Secret (optional) ---
# Used by /api/cron and GitHub Actions daily-seo workflow
# Falls back to ADMIN_TOKEN if not set
CRON_SECRET=""

# --- Social Matrix (营销第 2 步, all optional) ---
# Posting endpoints: /api/twitter-post /api/telegram-post /api/pinterest-post /api/reddit-post
# (auth: ?token=TELEGRAM_POST_SECRET or ADMIN_TOKEN)
# Cron posts daily hexagram to each configured platform automatically.
# Social posting languages, comma-separated (default en,ru,ja,ko; Reddit is en-only)
SOCIAL_LANGS="en,ru,ja,ko"

# --- X / Twitter ---
# https://developer.x.com → create app (Read + Write) → generate 4 keys
# Free tier: 500 posts/month — enough for 4 daily hexagram posts.
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# --- Pinterest (business account) ---
# https://developers.pinterest.com → app with pins:read/write, boards:read/write
# → OAuth 2.0 → long-lived access token. Board ID from the board URL
# (e.g. https://www.pinterest.com/username/board-name/ → create a pin via API to find numeric id)
PINTEREST_ACCESS_TOKEN=""
PINTEREST_BOARD_ID=""

# --- Reddit ---
# https://www.reddit.com/prefs/apps → create a "script" app → client id/secret
# Account must be allowed to post in the target subreddit (check each sub's rules first).
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""
REDDIT_SUBREDDIT="iching"
